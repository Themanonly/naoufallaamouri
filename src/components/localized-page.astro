---
interface Project {
  title: string;
  category: string;
  image?: string;
  preview: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  projectsHeading: string;
  contactHeading: string;
  contactText: string;
  contactLabel: string;
  projects: Project[];
}

const { eyebrow, heading, intro, projectsHeading, contactHeading, contactText, contactLabel, projects } = Astro.props;
---

<main id="home" data-section class="max-w-5xl mx-auto py-16 md:py-28 text-[var(--white)]">
  <header class="space-y-5 mb-20">
    <p class="text-[var(--sec)]">{eyebrow}</p>
    <h1 class="text-4xl md:text-6xl font-medium leading-tight">{heading}</h1>
    <p class="max-w-3xl text-lg md:text-2xl text-[var(--white-icon)]">{intro}</p>
  </header>

  <section id="projects" data-section aria-labelledby="localized-projects" class="border-t border-[#ffffff10] pt-10">
    <h2 id="localized-projects" class="text-3xl md:text-4xl font-medium mb-8">{projectsHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {projects.map((project) => (
        <a class="border border-[var(--white-icon-tr)] rounded-xl overflow-hidden bg-[#1414149c] hover:bg-[var(--white-icon-tr)] transition" href={project.preview} target="_blank" rel="noopener noreferrer">
          {project.image && (
            <img
              src={project.image}
              alt={`${project.title} website preview`}
              class="w-full aspect-[16/10] object-contain bg-[#f2f2f2]"
            />
          )}
          <div class="p-5">
          <span class="block text-xl font-semibold">{project.title}</span>
          <span class="block mt-2 text-[var(--sec)]">{project.category}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section id="contact" data-section aria-labelledby="localized-contact" class="border-t border-[#ffffff10] pt-10 mt-20">
    <h2 id="localized-contact" class="text-3xl md:text-4xl font-medium mb-4">{contactHeading}</h2>
    <p class="max-w-2xl text-lg text-[var(--white-icon)] mb-6">{contactText}</p>
    <a class="inline-flex rounded-full border border-[var(--white-icon-tr)] px-6 py-3 hover:bg-[var(--white-icon-tr)] transition" href="mailto:naoufalworking@gmail.com">{contactLabel}</a>
  </section>
</main>
