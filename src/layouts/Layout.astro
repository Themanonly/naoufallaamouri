---
import CookieConsent from "@/components/cookie-consent.astro";

interface Props {
  title: string;
  description?: string;
  locale?: string;
  dir?: "ltr" | "rtl";
  path?: string;
}

const {
  title,
  description = "Naoufal Laamouri - Créateur et développeur web au Maroc pour des sites responsives destinés aux entreprises et aux clients.",
  locale = "fr",
  dir = "ltr",
  path = "/",
} = Astro.props;
const siteUrl = "https://naoufallaamouri.netlify.app";
const canonical = new URL(path, siteUrl).toString();
const socialImage = `${siteUrl}/og/naoufal-laamouri-portfolio-v2.jpg`;
const locales = [
  ["fr", "/"],
  ["en", "/en/"],
  ["ar", "/ar/"],
  ["ar-MA", "/darija/"],
  ["ar-Latn-MA", "/darija-latn/"],
] as const;
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    <meta name="author" content="Naoufal Laamouri" />
    <meta name="copyright" content="© 2026 Naoufal Laamouri. All rights reserved." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    {locales.map(([hreflang, href]) => <link rel="alternate" hreflang={hreflang} href={new URL(href, siteUrl).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content={title}
    />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:image"
      content={socialImage}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Naoufal Laamouri — Web Designer & Developer in Morocco" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Naoufal Laamouri"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Naoufal Laamouri — Web Designer & Developer in Morocco" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Naoufal Laamouri",
        "alternateName": "Naoufal Laamouri",
        "url": "https://naoufallaamouri.netlify.app/",
        "image": "https://naoufallaamouri.netlify.app/og/naoufal-laamouri-portfolio-v2.jpg",
        "sameAs": [
          "https://github.com/Themanonly",
          "https://www.linkedin.com/in/themannaoufallaamouri/"
        ],
        "jobTitle": "Web Designer & Developer",
        "description": "Web Designer and Developer in Morocco creating responsive websites for businesses and clients.",
        "email": "naoufalworking@gmail.com",
        "areaServed": "Morocco",
        "author": "Naoufal Laamouri",
        "creator": "Naoufal Laamouri",
        "copyrightHolder": "Naoufal Laamouri"
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
    <CookieConsent />
  </body>
</html>

<script is:inline>
  const nav = document.getElementById("main-nav");
  const sections = Array.from(document.querySelectorAll("[data-section]"));
  const navLinks = Array.from(document.querySelectorAll("[data-nav-link]"));
  let navFrame = null;

  function updateNavigation() {
    if (window.scrollY > 0) {
      nav?.classList.add("scrolling");
      const progress = Math.min(window.scrollY / 1000, 1);
      const eased = 1 - Math.pow(1 - progress, 4);
      const maxWidth = window.innerWidth * 0.8;
      const currentWidth = maxWidth - (maxWidth - 528) * eased;
      if (window.innerWidth >= 768) nav?.style.setProperty("width", `${currentWidth}px`);
    } else {
      nav?.classList.remove("scrolling");
      nav?.style.setProperty("width", "80%");
    }

    if (!sections.length) return;
    const referenceLine = Math.min(window.innerHeight * 0.36, (nav?.getBoundingClientRect().bottom || 0) + 48);
    const visibleSection = sections.find((section) => {
      const bounds = section.getBoundingClientRect();
      return bounds.top <= referenceLine && bounds.bottom > referenceLine;
    });
    const currentSection = visibleSection || sections.reduce((closest, section) => {
      const distance = Math.abs(section.getBoundingClientRect().top - referenceLine);
      const closestDistance = Math.abs(closest.getBoundingClientRect().top - referenceLine);
      return distance < closestDistance ? section : closest;
    });
    const activeId = currentSection.getAttribute("id");
    navLinks.forEach((link) => link.classList.toggle("active", link.getAttribute("href") === `#${activeId}`));
  }

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", (event) => {
      event.preventDefault();
      const targetId = anchor.getAttribute("href")?.substring(1) || "";
      document.getElementById(targetId)?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  window.addEventListener("scroll", () => {
    if (!navFrame) navFrame = requestAnimationFrame(() => {
      updateNavigation();
      navFrame = null;
    });
  }, { passive: true });
  window.addEventListener("resize", updateNavigation);
  window.addEventListener("hashchange", updateNavigation);
  updateNavigation();
  window.setTimeout(updateNavigation, 0);
</script>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
