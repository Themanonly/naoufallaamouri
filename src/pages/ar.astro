  { title: "Coco Beauty Bar", category: "موقع تجميل وصالون", preview: "https://coco-beauty-bar-casablanca.netlify.app/" },
  { title: "Viet Garden", category: "موقع مطعم ومقهى", preview: "https://viet-garden.netlify.app/fr" },
  { title: "Dixvino", category: "موقع ضيافة ونبيذ", preview: "https://dixvino.netlify.app/" },
  { title: "Furni", category: "موقع أثاث متجاوب", preview: "https://furni-naoufal.netlify.app/" },
  { title: "Feane", category: "موقع مطعم ومقهى", preview: "https://feane-naoufal.netlify.app/" },
  { title: "Tailstore", category: "موقع أزياء ومتجر إلكتروني", preview: "https://tailstore-naoufal.netlify.app/" },
  { title: "Sarab", category: "موقع مطعم وتجربة طعام", preview: "https://sarab-naoufal.netlify.app/" },
  { title: "BloomShop", category: "موقع متجر حديث", preview: "https://bloomshop-naoufal-portfolio.netlify.app/" },
  { title: "Paredes Winery", category: "موقع مزرعة عنب وضيافة", preview: "https://paredes-winery-naoufal.netlify.app/" },
