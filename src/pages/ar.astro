---
<Layout title="نوفل العموري | مصمم ومطور مواقع ويب في المغرب" description="نوفل العموري مصمم ومطور مواقع ويب في المغرب، ينشئ مواقع احترافية ومتجاوبة للشركات والمشاريع." locale="ar" dir="rtl" path="/ar/">
  <LocalizedPage eyebrow="محفظة أعمال رقمية في المغرب" heading="تصميم وتطوير مواقع ويب احترافية" intro="أصمم وأطور مواقع واضحة ومتجاوبة تساعد الشركات والمشاريع على تقديم خدماتها بشكل موثوق على الإنترنت." projectsHeading="مشاريع مختارة" contactHeading="لنتحدث عن مشروعك" contactText="لديك فكرة أو خدمة أو مشروع تريد تقديمه عبر الإنترنت؟ أرسل لي رسالة لنبدأ الحديث." contactLabel="تواصل معي" projects={projects} />
</Layout>
